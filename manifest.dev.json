{
  "manifestVersion": 1,
  "name": "CFG Core (dev)",
  "version": "0.2.0",
  "summary": "Local-development build of the Crit-Fumble Core symbiote — points at a local core-browser.",
  "license": "AGPL-3.0-only",
  "entryPoint": "https://cfg-localdev.crit-fumble-web.workers.dev/talespire",
  "controls": {
    "reload": true,
    "navigation": true
  },
  "icons": {
    "64x64": "/icons/cfg-64x64.png",
    "notification": "/icons/cfg-24x24-mono.png"
  },
  "api": {
    "version": "0.1",
    "initTimeout": 10,
    "interop": {
      "id": "80dea37f-30cc-42bc-9774-748050fcfb9f"
    },
    "subscriptions": {
      "symbiote": {
        "onStateChangeEvent": "cfgTsStateChange"
      },
      "urls": {
        "onUrlMessage": "cfgTsUrlMessage"
      },
      "chat": {
        "onChatMessage": "cfgTsChatMessage"
      },
      "dice": {
        "onRollResults": "cfgTsRollResults"
      },
      "initiative": {
        "onInitiativeEvent": "cfgTsInitiative"
      },
      "creatures": {
        "onCreatureStateChange": "cfgTsCreatureState"
      },
      "clients": {
        "onClientEvent": "cfgTsClientEvent"
      }
    }
  },
  "environment": {
    "webViewBackgroundColor": "#1a1a2e",
    "capabilities": ["runInBackground"],
    "extras": ["fonts", "icons", "colorStyles"]
  }
}
